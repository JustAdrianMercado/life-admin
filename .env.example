# Contraseña para entrar a la app
APP_PASSWORD=
# Cadena aleatoria larga para firmar la sesión (ej: openssl rand -base64 32)
SESSION_SECRET=
# Postgres de Neon (lo agrega Vercel al conectar Neon). Vacío = PGlite local
DATABASE_URL=
# API key de tipo de cambio (gratis en https://wavesoft.cloud/developers)
WAVESOFT_API_KEY=
# Notificaciones push: genera las claves con "npx web-push generate-vapid-keys"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Cadena aleatoria larga; Vercel la manda al llamar al cron diario (/api/cron/notify)
CRON_SECRET=
